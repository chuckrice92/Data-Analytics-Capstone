    <worksheet name='Sheet 8'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Revenue Correlation</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='restaurant_data' name='federated.1m7juqo1mxlmsi14bkwme1ufyy98' />
          </datasources>
          <datasource-dependencies datasource='federated.1m7juqo1mxlmsi14bkwme1ufyy98'>
            <column aggregation='Sum' datatype='real' name='[Ambience Score]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[Average Meal Price]' role='dimension' type='ordinal' />
            <column caption='Revenue/AMP' datatype='real' name='[Calculation_1780409274892289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Average Meal Price] )' />
            </column>
            <column caption='Revenue/Marketing budget' datatype='real' name='[Calculation_1780409275375618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Marketing Budget] )' />
            </column>
            <column caption='Revenue/Social' datatype='real' name='[Calculation_1780409275764739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Social Media Followers] )' />
            </column>
            <column caption='Revenue/Seating' datatype='real' name='[Calculation_1780409276276740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Seating Capacity] )' />
            </column>
            <column caption='Revenue/Rating' datatype='real' name='[Calculation_1780409276719109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Rating] )' />
            </column>
            <column caption='Revenue/Chef' datatype='real' name='[Calculation_1780409277288455]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Chef Experience Years] )' />
            </column>
            <column caption='Revenue/SQS' datatype='real' name='[Calculation_1780409277460488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Service Quality Score] )' />
            </column>
            <column caption='Revenue/Ambience' datatype='real' name='[Calculation_1780409277874185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue], [Ambience Score] )' />
            </column>
            <column caption='Revenue  /Weekday Res' datatype='real' name='[Calculation_1985195706564608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue], [Weekday Reservations])' />
            </column>
            <column caption='Revenue/Weekend Res' datatype='real' name='[Calculation_1985195706945537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CORR([Revenue],[Weekend Reservations])' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Chef Experience Years]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Cuisine]' role='dimension' type='nominal' />
            <column datatype='string' name='[Location]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[Marketing Budget]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[Rating]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Revenue]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[Seating Capacity]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[Service Quality Score]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[Social Media Followers]' role='dimension' type='ordinal' />
